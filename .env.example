# =============================================================================
# JEEVANCARE PRODUCTION ENVIRONMENT VARIABLE TEMPLATE
# =============================================================================

# Server URL & Node Environment
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NODE_ENV=production

# Payload CMS Secret (Generate a strong random 32+ char secret)
PAYLOAD_SECRET=your-32-character-random-payload-secret-key-here

# MongoDB Connection String (MUST be a Replica Set instance/cluster)
DATABASE_URL=mongodb://127.0.0.1:27017/jeevancare?replicaSet=rs0

# Cron Secret for Daily Digest & Cleanup (/api/cron/daily-digest)
CRON_SECRET=your-random-cron-bearer-token-secret-here

# Email Provider Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_ADDRESS=noreply@jeevancare.in
DEFAULT_FROM_NAME="JeevanCare Clinics"
